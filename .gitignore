# --- Python / tooling ---
.venv/
.venv-analysis/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.log

# --- Secrets / credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*secret*
*credentials*
id_rsa*
id_ed25519*
*.token
apify_token*
.secrets/
config/local*.yaml
config/*secret*

# --- Phase briefs and agent-only notes ---
phases/
handoff.md

# --- Local research data ---
# Keep cleaned corpus CSVs; ignore raw dumps and heavy intermediates.
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep

data/processed/**
!data/processed/.gitkeep
!data/processed/corpus_a.csv
!data/processed/corpus_b.csv

data/analysis/**
!data/analysis/.gitkeep
!data/analysis/corpus_a.csv
!data/analysis/corpus_b.csv

# --- Generated analysis artifacts (rebuildable) ---
# Full outputs/ stays local; publication figures are mirrored under docs/figures/
outputs/**
!outputs/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Notebooks checkpoints ---
notebooks/.ipynb_checkpoints/
*.bak
