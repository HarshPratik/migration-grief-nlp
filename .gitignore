# --- Local research data ---
# Keep cleaned corpus CSVs; ignore raw dumps and heavy intermediates.
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep

data/processed/**
!data/processed/.gitkeep
!data/processed/corpus_a.csv
!data/processed/corpus_b.csv
!data/processed/PHASE1_COMPLETE.md

data/analysis/**
!data/analysis/.gitkeep
!data/analysis/corpus_a.csv
!data/analysis/corpus_b.csv

# --- Manual annotation pack (contains post excerpts) ---
annotation/*.xlsx
annotation/*.html
annotation/*coded*

# --- Generated analysis artifacts (rebuildable) ---
# Full outputs/ stays local; publication figures are mirrored under docs/figures/
outputs/**
!outputs/.gitkeep

# --- Local scratch (cloud JSON, one-off helpers) ---
tmp_*
tmp_boot_volume*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Notebooks checkpoints ---
notebooks/.ipynb_checkpoints/
*.bak
